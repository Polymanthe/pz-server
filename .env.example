# Base container image. Keep the tag and digest together when updating.
PZ_IMAGE=docker.io/indifferentbroccoli/projectzomboid-server-docker:v1.1.8@sha256:950d7b4ff19a04d3f8a1a35af383526ad95c88a9a4d795760b3a9b00ee80b1a0

# Container user. Named volumes normally work with these defaults.
PUID=1000
PGID=1000

# Generated by task init. Replace these values manually when not using Task.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME_ADMIN
RCON_PASSWORD=CHANGEME_RCON
RCON_PORT=27015

# Server identity and Steam branch. An empty branch selects the stable build.
SERVER_NAME=pzserver
SERVER_BRANCH=

# Network and player settings.
DEFAULT_PORT=16261
UDP_PORT=16262
# Public DNS name or IP shared with players. Do not include a scheme or port.
SERVER_CONNECT_ADDRESS=
MAX_PLAYERS=8
PUBLIC_SERVER=false
STEAM_VAC=true
USE_STEAM=true

# Installation and update policy. Missing server files are always installed.
UPDATE_ON_START=false

# JVM memory must remain below the container memory limit.
MEMORY_XMX_GB=6
MEMORY_XMS_GB=
VM_ARGS=
CONTAINER_MEMORY_LIMIT=10G
CONTAINER_CPU_LIMIT=4.0

# Docker log rotation.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Companion web site. Leave empty to run the game server alone; set to "web"
# to also start the site and its reverse proxy.
COMPOSE_PROFILES=

# Public host name served by Caddy. A real name enables automatic HTTPS.
# Keep :80 for a local deployment, which disables it.
WEB_DOMAIN=:80
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443

# Credentials for the log panel, the only authenticated part of the site.
# Generate the hash with task web:password. The value contains dollar signs:
# write them doubled ($$) so Docker Compose does not expand them.
WEB_LOGS_USER=admin
WEB_LOGS_PASSWORD_HASH=

# Networks allowed to set the client IP address seen by Caddy. Replace with the
# Cloudflare ranges when the site sits behind Cloudflare.
WEB_TRUSTED_PROXIES=private_ranges

# Fetch mod titles and thumbnails from Steam. The site works without it.
PZ_STEAM_ENRICHMENT=true
